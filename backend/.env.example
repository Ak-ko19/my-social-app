# The server checks these at startup (config/env.js) and refuses to start,
# listing every problem, if a required one is missing or malformed.
# Required everywhere: DATABASE_URL, JWT_SECRET.
# Also required in production (NODE_ENV=production or on Render):
# ALLOWED_ORIGINS, FRONTEND_URL.

DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# A long random string (32+ characters; e.g. 64 hex characters).
JWT_SECRET=your_jwt_secret_here
# Optional. Port to listen on; Render sets it automatically. Default 3000.
# PORT=3000
# Comma-separated list of origins allowed to call this API (the frontend's
# URL(s)), exactly like https://my-app.vercel.app: no path, no trailing slash.
ALLOWED_ORIGINS=http://localhost:5173
# Optional. Number of reverse proxies in front of this server, so rate limits
# see each client's real IP. Leave unset: it defaults to 1 on Render (and in
# production) and to off in local dev. Only set it if the hosting changes,
# e.g. 2 if a CDN is added in front of Render. Must be a whole number.
# TRUST_PROXY=1
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Real email delivery for signup verification / password reset links.
#
# Production (Render): Render's free tier blocks outbound SMTP, so use
# Brevo's HTTPS API (free: 300 emails/day). Create an API key in Brevo
# (SMTP & API -> API Keys) and verify a sender address (Senders & IP ->
# Senders). When BREVO_API_KEY is set it is used instead of SMTP.
# BREVO_API_KEY=your_brevo_api_key_here
# EMAIL_FROM must then be that verified sender (see EMAIL_FROM below).
#
# Local dev: SMTP. $0 option: Gmail + an App Password (Google Account -> Security
# -> 2-Step Verification (must be on) -> App Passwords -> generate one for
# "Mail"). Use that 16-character app password below, NOT your real Gmail
# password. Any other SMTP provider works the same way (just change host/
# port/user/pass) -- no code change needed either way.
# With no provider (no BREVO_API_KEY and no EMAIL_HOST/USER/PASS), nothing
# is sent. In local dev the email is written to the server console instead;
# in production it never is (it contains live reset/verification links).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password_here
EMAIL_FROM=MySocialApp <your_email@gmail.com>

# Optional (production). Shared secret for the daily cleanup job
# (POST /internal/cleanup, called by .github/workflows/cleanup.yml): 32+
# random characters, e.g. 64 hex characters. Put the SAME value in GitHub ->
# Settings -> Secrets and variables -> Actions -> Secrets as CLEANUP_SECRET.
# Unset = the endpoint doesn't exist (404) and nothing is cleaned up.
# CLEANUP_SECRET=

# Optional. Also send server errors to Sentry (they are always kept in the
# app's own error log: Settings -> Moderation -> Errors). Unset = off, and
# the Sentry SDK isn't even loaded.
# SENTRY_DSN=https://<key>@<host>.ingest.sentry.io/<project>

# Optional. Cloudflare Turnstile "are you human?" check on signup and
# forgot password (free: Cloudflare dashboard -> Turnstile -> Add widget).
# It turns on only when BOTH are set. Unset = off; the honeypot, form
# timing and rate limits still protect those forms.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Optional. The API reference (GET /docs, and the spec at GET /openapi.json)
# is on in development; in production only when this is 1.
# API_DOCS=1

# Base URL of the frontend that verify-email/reset-password links point at.
# Use your real deployed frontend URL outside of local dev (no trailing slash).
FRONTEND_URL=http://localhost:5173
